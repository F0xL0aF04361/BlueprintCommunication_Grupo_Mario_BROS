# =============================================================================
# .gitignore for an Unreal Engine project on GitHub
# =============================================================================
# Pairs with the .gitattributes file: that file decides HOW tracked files are
# handled (LFS, line endings); this file decides WHICH files are never tracked.
#
# NOTE: .gitignore only affects untracked files. If a folder below was already
# committed, run:  git rm -r --cached <folder>
# =============================================================================


# -----------------------------------------------------------------------------
# 1. UNREAL ENGINE: GENERATED / REBUILDABLE FOLDERS
# -----------------------------------------------------------------------------
# Regenerated automatically when the project is opened or built.

# Compiled binaries (rebuilt from source)
Binaries/
**/Binaries/

# Intermediate build files
Intermediate/
**/Intermediate/

# Shared derived data (shader and asset caches)
DerivedDataCache/
**/DerivedDataCache/

# Logs, crash dumps, autosaves, local config, screenshots
Saved/
**/Saved/

# Packaged / cooked builds output
PackagedBuilds/
Packaged/
Staging/

# Engine-generated platform project folders
Platforms/*/Intermediate/
Platforms/*/Binaries/

# Generated project files (right-click .uproject > Generate Visual Studio
# project files to recreate them)
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.xcodeproj
*.xcworkspace
.vscode/
*.code-workspace
*.uprojectdirs.user
Plugins/*/Intermediate/
Plugins/**/Intermediate/
Plugins/*/Binaries/
Plugins/**/Binaries/


# -----------------------------------------------------------------------------
# 2. IDE / EDITOR FILES
# -----------------------------------------------------------------------------

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.ipch
ipch/
*.pidb

# Rider / JetBrains
.idea/
*.sln.iml
.idea_modules/

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/

# Visual Studio Code (keep shared settings if you use them)
# .vscode/ is ignored above; remove that line to share workspace settings.

# Other editors
*.swp
*.swo
*~
.#*
\#*#


# -----------------------------------------------------------------------------
# 3. COMPILED OUTPUT / BUILD ARTIFACTS
# -----------------------------------------------------------------------------
*.o
*.obj.tmp
*.exe.tmp
*.ilk
*.exp
*.idb
*.pch
*.gch
*.log
*.tlog
*.lastbuildstate
*.unsuccessfulbuild
*.dmp
*.mdmp
*.crash
*.dSYM/
*.apk.idsig
*.dll.config.tmp

# Build tool outputs
*.UnrealVS/
UE4Games.uprojectdirs.user
UnrealBuildTool*.log


# -----------------------------------------------------------------------------
# 4. UNREAL-SPECIFIC LOCAL / TEMPORARY FILES
# -----------------------------------------------------------------------------

# Local editor state (per-user, not shared)
Config/DefaultEditorPerProjectUserSettings.ini.user
Config/UserEditorPerProjectUserSettings.ini

# Autosaves and backups
*.autosave
*.bak
*.backup
*.tmp
*.temp
*.orig
*.rej
*_BuiltData.uasset.tmp

# Crash reports
**/CrashReportClient/
CrashReports/

# Rendered output / local captures
MovieRenders/
Saved/MovieRenders/
Screenshots/
**/Screenshots/

*.pak.tmp

# Source control integration leftovers
.p4config
*.p4ignore
.perforce/


# -----------------------------------------------------------------------------
# 5. SECRETS / LOCAL CREDENTIALS  (never commit these)
# -----------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*.mobileprovision
*.cer
secrets.json
credentials.json
google-services.json
GoogleService-Info.plist


# -----------------------------------------------------------------------------
# 6. OS CLUTTER
# -----------------------------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd

# Linux
.directory
.Trash-*
.nfs*


# -----------------------------------------------------------------------------
# 7. PACKAGE MANAGERS / TOOLING
# -----------------------------------------------------------------------------
node_modules/
__pycache__/
*.pyc
.venv/
venv/


# -----------------------------------------------------------------------------
# 8. OPTIONAL: DOWNLOADED MARKETPLACE / THIRD-PARTY CONTENT
# -----------------------------------------------------------------------------
# Uncomment if you don't want to commit purchased assets or plugins that each
# teammate installs themselves through the Epic Games Launcher.
#
# Plugins/Marketplace/
# Content/Marketplace/
# Content/ThirdParty/
