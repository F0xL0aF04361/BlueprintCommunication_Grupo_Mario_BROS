# Auto detect text files and perform LF normalization
* text=auto
# Example folder using LFS
Content/BlueprintCommunication 5.8/** filter=lfs diff=lfs merge=lfs -text
______________________________
# unreal assests
______________________________
*.uassest filter=lfs diff=lfs merge=lfs -text
## -----------------------------------------------------------------------------
# 2. TEXT FILES  (NOT in LFS)
# -----------------------------------------------------------------------------
# --- Unreal project / config files ---
*.uproject          text eol=lf linguist-language=JSON
*.uplugin           text eol=lf linguist-language=JSON
*.uprojectdirs      text eol=lf
*.ini               text eol=lf
*.target            text eol=lf
*.modules           text eol=lf
# --- C++ source ---
*.c                 text eol=lf diff=cpp
*.cc                text eol=lf diff=cpp
*.cpp               text eol=lf diff=cpp
*.cxx               text eol=lf diff=cpp
*.h                 text eol=lf diff=cpp
*.hpp               text eol=lf diff=cpp
*.inl               text eol=lf diff=cpp
*.ipp               text eol=lf diff=cpp
*.m                 text eol=lf
*.mm                text eol=lf
# --- C# build scripts (Build.cs / Target.cs) ---
*.cs                text eol=lf diff=csharp
*.csproj            text eol=lf
*.sln               text eol=lf
# --- Shaders ---
*.usf               text eol=lf
*.ush               text eol=lf
*.hlsl              text eol=lf
*.glsl              text eol=lf
# --- Scripts / build tooling ---
*.py                text eol=lf diff=python
*.sh                text eol=lf
*.bat               text eol=lf
*.cmd               text eol=lf
*.ps1               text eol=lf
*.js                text eol=lf
*.ts                text eol=lf
*.xml               text eol=lf
*.plist             text eol=lf
*.cmake             text eol=lf
CMakeLists.txt      text eol=lf
Makefile            text eol=lf
# --- Data / docs ---
*.json              text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf
*.csv               text eol=lf
*.tsv               text eol=lf
*.txt               text eol=lf
*.md                text eol=lf diff=markdown
*.html              text eol=lf diff=html
*.css               text eol=lf diff=css
*.toml              text eol=lf
*.po                text eol=lf
*.pot               text eol=lf
*.locres.txt        text eol=lf
# --- Git / editor config ---
.gitattributes      text eol=lf
.gitignore          text eol=lf
.gitmodules         text eol=lf
.editorconfig       text eol=lf
.clang-format       text eol=lf
.clang-tidy         text eol=lf
# -----------------------------------------------------------------------------
# 3. BINARY FILES  (NOT in LFS)
# -----------------------------------------------------------------------------
# Small binaries (icons, thumbnails, tiny UI images). If any of these grow
# large in your project, move them to Section 4.
*.ico               binary
*.icns              binary
*.svg               text eol=lf
*.gif               binary
# -----------------------------------------------------------------------------
# 4. LFS-TRACKED FILES  (large binary assets)
# -----------------------------------------------------------------------------
# lockable = file is read-only until locked (git lfs lock), which prevents
# merge conflicts on files that cannot be merged. Use on Unreal assets.
# --- Unreal assets & levels (binary, unmergeable -> lockable) ---
*.uasset            filter=lfs diff=lfs merge=lfs -text lockable
*.umap              filter=lfs diff=lfs merge=lfs -text lockable
*.upk               filter=lfs diff=lfs merge=lfs -text lockable
